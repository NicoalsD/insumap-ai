# Servicio de IA de Insumap (docs/Contrato-IA.md, sección 10.2). Copia a .env o expórtalas.

# Token de servicio: secreto de al menos 32 bytes, igual al AI_SERVICE_TOKEN del backend.
# python -c "import secrets; print(secrets.token_urlsafe(32))"
AI_SERVICE_TOKEN=
# Token anterior, solo durante una rotación (Contrato-IA 2.2).
AI_SERVICE_TOKEN_PREVIOUS=

# offline: sin LLM (pruebas y CI; IA5 e IA6 responden con la plantilla).
# openai_compatible: LLM remoto con API compatible con OpenAI.
AI_PROVIDER_FAMILY=offline

# LLM: únicas variables del proveedor. Ejemplo con Gemini (capa gratuita):
#   LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
#   LLM_MODEL=<un modelo de GET {LLM_BASE_URL}models>
# La capa gratuita puede usar los datos para entrenar: al LLM solo llegan datos
# seudonimizados y redactados (PhiRedactingTextGenerator).
LLM_BASE_URL=
LLM_MODEL=
LLM_API_KEY=
# Menor que los timeouts del backend (30 s resumen, 20 s asistente).
LLM_TIMEOUT_SECONDS=15
LLM_MAX_OUTPUT_TOKENS=2048
# Opcional, para modelos con razonamiento: none, low, medium o high.
LLM_REASONING_EFFORT=

# Límites técnicos (Contrato-IA 3.3).
MAX_BODY_BYTES=524288
MAX_FORECAST_POINTS=2048
FORECAST_MIN_POINTS=36
MAX_DOSES=500
MAX_CONTEXT_DOCS=8
MAX_CONTEXT_DOC_CHARS=4000
MAX_MESSAGE_CHARS=1000
MAX_HISTORY_TURNS=10
GLUCOSE_PLAUSIBLE_MIN=20
GLUCOSE_PLAUSIBLE_MAX=600

# Hiperparámetros del pronóstico de tendencia amortiguada (IA1).
FORECAST_SLOPE_WINDOW_MINUTES=30
FORECAST_RESIDUAL_WINDOW_POINTS=36
FORECAST_SPREAD_FLOOR_MG_DL=4
FORECAST_TREND_THRESHOLD_MG_DL_MIN=1
FORECAST_DAMPING_PER_HOUR=0.5

# Riesgo (IA2 e IA7): suficiencia mínima de datos y cortes de nivel de la ficha.
RISK_MIN_DATA_SUFFICIENCY_PCT=70
RISK_TIER_MEDIUM=0.2
RISK_TIER_HIGH=0.5
RISK_TIER_CRITICAL=0.8

# Swagger en /docs. false en producción.
API_DOCS_ENABLED=true
